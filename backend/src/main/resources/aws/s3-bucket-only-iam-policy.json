{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "PickeltonMediaBucketObjectAccess",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::pickelton-prod-media-426771917778/*"
    },
    {
      "Sid": "PickeltonMediaBucketListAccess",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "arn:aws:s3:::pickelton-prod-media-426771917778"
    }
  ]
}
