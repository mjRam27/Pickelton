DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me

# Rotate any previously exposed Upstash credential and use the replacement here.
# Use rediss:// so TLS is explicit.
REDIS_URL=rediss://default:replace-me@YOUR_UPSTASH_HOST:6379
# Local redis-server instead: REDIS_URL=redis://localhost:6379 and SPRING_DATA_REDIS_SSL_ENABLED=false
MATCH_CACHE_TTL_MINUTES=120

JWT_PRIVATE_KEY=replace-with-pkcs8-private-key
JWT_PUBLIC_KEY=replace-with-public-key
# Access token (JWT) lifetime and sign-in session lifetime; the session extends each time it's used.
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=2592000000
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000

# SMS verification (Twilio Verify). Without these, codes are only logged in the dev profile.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
# Private folder for host ID documents (use a persistent disk in production)
KYC_UPLOAD_DIR=uploads/kyc
# Use "prod" in production so verification codes are never written to logs
SPRING_PROFILE=dev
