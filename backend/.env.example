DATABASE_URL=jdbc:postgresql://YOUR_SUPABASE_HOST:5432/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=replace-me

# Rotate any previously exposed Upstash credential and use the replacement here.
# Use rediss:// so TLS is explicit.
REDIS_URL=rediss://default:replace-me@YOUR_UPSTASH_HOST:6379
MATCH_CACHE_TTL_MINUTES=120

JWT_PRIVATE_KEY=replace-with-pkcs8-private-key
JWT_PUBLIC_KEY=replace-with-public-key
SERVER_PORT=8080
ALLOWED_ORIGINS=http://localhost:3000
